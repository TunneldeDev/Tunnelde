{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "terminal",
  "type": "object",
  "properties": {
    "scrollback": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 100000
    },
    "lineHeight": {
      "type": "number",
      "minimum": 1,
      "maximum": 1.8,
      "multipleOf": 0.1
    },
    "cursorStyle": {
      "type": "string",
      "enum": [
        "block",
        "bar",
        "underline"
      ]
    },
    "cursorBlink": {
      "type": "boolean"
    },
    "inactiveCursorStyle": {
      "type": "string",
      "enum": [
        "block",
        "bar",
        "underline",
        "outline",
        "none"
      ]
    },
    "scrollSensitivity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "smoothScrolling": {
      "type": "boolean"
    },
    "scrollOnInput": {
      "type": "boolean"
    },
    "copyOnSelect": {
      "type": "boolean"
    },
    "applicationClipboard": {
      "type": "boolean"
    },
    "rightClick": {
      "type": "string",
      "enum": [
        "menu",
        "copyPaste",
        "paste"
      ]
    },
    "renderer": {
      "type": "string",
      "enum": [
        "auto",
        "dom"
      ]
    },
    "recordHistory": {
      "type": "boolean"
    }
  },
  "required": [
    "scrollback",
    "lineHeight",
    "cursorStyle",
    "cursorBlink",
    "inactiveCursorStyle",
    "scrollSensitivity",
    "smoothScrolling",
    "scrollOnInput",
    "copyOnSelect",
    "applicationClipboard",
    "rightClick",
    "renderer",
    "recordHistory"
  ],
  "additionalProperties": false
}
