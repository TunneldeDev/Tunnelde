{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental live file-browser RPC schemas, schemaVersion 1",
  "description": "Text and complete serialized-page UTF-8 byte limits are additionally enforced by the host/SDK. Revisions describe UI state, not atomic filesystem snapshots. Permission and cancellation are enforced by the native broker.",
  "definitions": {
    "metadata": {
      "type": "object",
      "properties": {
        "paneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "tabId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "local"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "remote"
                },
                "sessionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                }
              },
              "required": ["kind", "sessionId"],
              "additionalProperties": false
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768,
              "pattern": "^[^\\u0000]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "busy": {
          "type": "boolean"
        },
        "suspended": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "errorTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "paneId",
        "tabId",
        "revision",
        "source",
        "path",
        "total",
        "selectedCount",
        "busy",
        "suspended",
        "error",
        "errorTruncated"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768,
          "pattern": "^[^\\u0000]+$"
        },
        "isDir": {
          "type": "boolean"
        },
        "isHidden": {
          "type": "boolean"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modified": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "path",
        "isDir",
        "isHidden",
        "size",
        "modified",
        "permissions",
        "selected"
      ],
      "additionalProperties": false
    },
    "catalogue": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/metadata"
          }
        }
      },
      "required": ["total", "offset", "nextOffset", "items"],
      "additionalProperties": false
    }
  },
  "methods": {
    "fileBrowser.observe": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "resultSchema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "changed": {
                "const": false
              }
            },
            "required": ["schemaVersion", "revision", "changed"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "changed": {
                "const": true
              },
              "snapshot": {
                "$ref": "#/definitions/catalogue"
              }
            },
            "required": ["schemaVersion", "revision", "changed", "snapshot"],
            "additionalProperties": false
          }
        ]
      }
    },
    "fileBrowser.read": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "paneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "required": ["paneId", "revision"],
        "additionalProperties": false
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "paneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/definitions/entry"
            }
          }
        },
        "required": [
          "schemaVersion",
          "paneId",
          "revision",
          "total",
          "offset",
          "nextOffset",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "fileBrowser.action": {
      "inputSchema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "paneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "action": {
                "const": "refresh"
              }
            },
            "required": ["paneId", "revision", "action"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "paneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "action": {
                "const": "navigate"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768,
                "pattern": "^[^\\u0000]+$"
              }
            },
            "required": ["paneId", "revision", "action", "path"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "paneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "action": {
                "const": "select"
              },
              "paths": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32768,
                  "pattern": "^[^\\u0000]+$"
                }
              }
            },
            "required": ["paneId", "revision", "action", "paths"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "paneId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "action": {
                "const": "open"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768,
                "pattern": "^[^\\u0000]+$"
              },
              "mode": {
                "enum": ["open", "preview"]
              }
            },
            "required": ["paneId", "revision", "action", "path"],
            "additionalProperties": false
          }
        ]
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "accepted": {
            "const": true
          }
        },
        "required": ["accepted"],
        "additionalProperties": false
      }
    }
  }
}
