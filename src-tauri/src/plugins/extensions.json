{
  "version": 1,
  "stability": "experimental",
  "frontend": {
    "sdkVersion": "0.1.0",
    "stability": "experimental",
    "trust": "host-context",
    "permission": "ui.trusted",
    "manifest": "frontend",
    "runtime": "frontend",
    "viewKind": "component",
    "providers": {
      "manifest": "views[].provider",
      "targets": ["hostList", "workbench", "fileBrowser", "terminal", "history"],
      "selection": "explicit-user",
      "hostListPermission": "hosts.read",
      "fileBrowserPermissions": ["fs.read", "sftp.read", "workspace.write"],
      "terminalPermissions": ["sessions.read", "ssh.exec"],
      "historyPermissions": ["sessions.read", "history.read"],
      "history": {
        "context": "history",
        "ownership": "host-panel",
        "optionalSlot": "Entries",
        "pageSize": 128,
        "pageTextLimit": 65536,
        "paging": "revision-bound",
        "writePermission": "history.write",
        "executePermission": "ssh.exec",
        "recovery": "native-search-and-confirmation"
      },
      "terminal": {
        "context": "terminal",
        "ownership": "host-session",
        "requiredSlot": "Screen",
        "pageSize": 128,
        "pageTextLimit": 65536,
        "lineTextLimit": 4096,
        "inputTextLimit": 65536,
        "subscriptions": 16,
        "notificationIntervalMs": 100,
        "paging": "revision-bound",
        "stream": "coalesced-dirty",
        "recovery": "native-toolbar-and-screen"
      },
      "fileBrowser": {
        "context": "fileBrowser",
        "ownership": "host-pane",
        "pageSize": 256,
        "paging": "revision-bound",
        "recovery": "native-path-and-actions"
      },
      "slots": ["Workspace", "Navigation", "Inspector", "StatusBar"],
      "requiredSlot": "Workspace",
      "limits": { "perPlugin": 8 },
      "fallback": "built-in"
    },
    "components": [
      "Button",
      "IconButton",
      "Field",
      "Input",
      "Textarea",
      "Switch",
      "SearchField",
      "EmptyState"
    ],
    "limits": { "moduleBytes": 8388608, "totalBytes": 33554432, "owners": 16 }
  },
  "layers": ["contract", "runtime", "data", "presentation", "behavior", "governance"],
  "domains": [
    {
      "id": "platform",
      "namespaces": ["api", "extensions", "app"]
    },
    {
      "id": "hosts",
      "namespaces": ["hosts", "groups", "hostList", "sessions"]
    },
    {
      "id": "files",
      "namespaces": ["files", "editor", "clipboard"]
    },
    {
      "id": "terminal",
      "namespaces": ["terminal", "history"]
    },
    {
      "id": "remote",
      "namespaces": ["forwards", "mounts", "runners", "tools"]
    },
    {
      "id": "tasks",
      "namespaces": ["tasks"]
    },
    {
      "id": "monitor",
      "namespaces": ["monitor"]
    },
    {
      "id": "workbench",
      "namespaces": ["workspace", "ui", "statusBar", "tabBar"]
    },
    {
      "id": "preferences",
      "namespaces": ["settings", "storage"]
    },
    {
      "id": "governance",
      "namespaces": ["events", "log", "secrets"]
    }
  ],
  "points": [
    {
      "id": "hosts.sources",
      "domain": "hosts",
      "layer": "data",
      "stability": "experimental",
      "composition": "merge",
      "ownership": "runtime",
      "registration": {
        "set": "hosts.setSource",
        "remove": "hosts.removeSource",
        "read": "hosts.sourcesSnapshot"
      },
      "permissions": ["hosts.read", "hosts.write"],
      "readPermissions": ["hosts.read"],
      "identity": "owner-source-content-sha256",
      "persistence": false,
      "limits": {
        "perPlugin": 8,
        "total": 128,
        "entriesPerSource": 256,
        "entriesPerPlugin": 512,
        "entriesTotal": 4096,
        "serializedBytesTotal": 4194304
      }
    },
    {
      "id": "hostList.columns",
      "domain": "hosts",
      "layer": "presentation",
      "stability": "experimental",
      "composition": "merge",
      "ownership": "runtime",
      "registration": { "set": "hostList.setColumn", "remove": "hostList.removeColumn" },
      "permissions": ["hosts.read", "workspace.write"],
      "limits": {
        "perPlugin": 8,
        "total": 128,
        "cellsPerColumn": 256,
        "textCodePoints": 512,
        "serializedBytesPerPlugin": 524288,
        "serializedBytesTotal": 4194304
      }
    },
    {
      "id": "hosts.fields",
      "domain": "hosts",
      "layer": "data",
      "stability": "experimental",
      "composition": "merge",
      "registration": {
        "manifest": "hostFields",
        "read": "hosts.getFields",
        "replace": "hosts.setFields"
      },
      "ownership": "manifest",
      "permissions": ["hosts.read"],
      "writePermissions": ["hosts.read", "hosts.write"],
      "limits": {
        "fieldsPerPlugin": 32,
        "documentBytes": 32768,
        "pluginBytes": 4194304,
        "totalBytes": 33554432,
        "pluginDocuments": 2048,
        "totalDocuments": 16384
      },
      "persistence": "plugin-host",
      "concurrency": "revision-and-schema-digest",
      "secrets": false
    },
    {
      "id": "hostList.menu",
      "domain": "hosts",
      "layer": "presentation",
      "stability": "experimental",
      "composition": "merge",
      "registration": { "manifest": "commands[].hostMenu" },
      "ownership": "manifest",
      "permissions": ["hosts.read"],
      "limits": { "perPlugin": 16, "total": 128 }
    },
    {
      "id": "hostList.decorations",
      "domain": "hosts",
      "layer": "presentation",
      "stability": "experimental",
      "composition": "merge",
      "registration": {
        "set": "hostList.setDecorations",
        "remove": "hostList.removeDecorations"
      },
      "ownership": "runtime",
      "permissions": ["hosts.read", "workspace.write"],
      "limits": {
        "perPlugin": 8,
        "total": 128,
        "entriesPerCollection": 256
      }
    },
    {
      "id": "statusBar.items",
      "domain": "workbench",
      "layer": "presentation",
      "stability": "stable",
      "composition": "merge",
      "registration": {
        "set": "statusBar.set",
        "remove": "statusBar.remove"
      },
      "ownership": "runtime",
      "permissions": [],
      "limits": {
        "perPlugin": 8,
        "total": 128
      }
    },
    {
      "id": "tabBar.items",
      "domain": "workbench",
      "layer": "presentation",
      "stability": "stable",
      "composition": "merge",
      "registration": {
        "set": "tabBar.set",
        "remove": "tabBar.remove"
      },
      "ownership": "runtime",
      "permissions": [],
      "limits": {
        "perPlugin": 8,
        "total": 128
      }
    }
  ]
}
