{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transfers",
  "type": "object",
  "properties": {
    "optimization": {
      "type": "boolean"
    },
    "compression": {
      "type": "boolean"
    },
    "concurrency": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        4,
        8
      ]
    },
    "chunkKib": {
      "type": "integer",
      "enum": [
        0,
        256,
        1024,
        4096,
        16384
      ]
    },
    "requests": {
      "type": "integer",
      "enum": [
        0,
        1,
        4,
        8,
        16,
        32
      ]
    },
    "uploadLimitKib": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "downloadLimitKib": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    }
  },
  "required": [
    "optimization",
    "compression",
    "concurrency",
    "chunkKib",
    "requests",
    "uploadLimitKib",
    "downloadLimitKib"
  ],
  "additionalProperties": false
}
