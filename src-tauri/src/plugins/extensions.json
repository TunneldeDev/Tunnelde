    },
    {
      "id": "tabBar.items",
      "domain": "workbench",
      "layer": "presentation",
      "stability": "stable",
      "composition": "merge",
      "registration": {
        "set": "tabBar.set",
        "remove": "tabBar.remove"
      },
      "ownership": "runtime",
      "permissions": [],
      "limits": {
        "perPlugin": 8,
        "total": 128
