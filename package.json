{
  "name": "tunnelde",
  "version": "0.26.1",
  "private": true,
  "type": "module",
  "description": "Desktop SSH and SFTP workstation with a plugin system",
  "license": "GPL-3.0-only",
  "author": "quyansiyuanwang",
  "homepage": "https://github.com/TunneldeDev/Tunnelde",
  "repository": {
    "type": "git",
    "url": "https://github.com/TunneldeDev/Tunnelde"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "release:prepare": "node scripts/release/release.mjs",
    "release:notes": "node scripts/release/changelog.mjs notes",
    "version:check": "node scripts/release/version.mjs check",
    "i18n:check": "node scripts/ci/check-i18n.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:local": "node scripts/build-local.mjs",
    "docs:check": "node scripts/ci/check-docs.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.12.0-beta.333",
    "@xterm/addon-serialize": "0.15.0-beta.331",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.331",
    "@xterm/addon-webgl": "0.20.0-beta.330",
    "@xterm/xterm": "6.1.0-beta.338",
    "clsx": "2.1.1",
    "i18next": "26.7.2",
    "lucide-react": "1.77.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "6.15.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
