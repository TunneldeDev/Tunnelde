            "maxLength": 128,
            "not": {
              "anyOf": [
                {
                  "pattern": "[^A-Za-z0-9._-]"
                },
                {
                  "enum": ["__proto__", "constructor", "prototype"]
                }
              ]
            }
          }
        },
        "additionalProperties": true
      },
      "resultSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#"
