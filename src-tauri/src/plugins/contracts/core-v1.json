      },
      "resultSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "hostId", "title", "address", "cols", "rows", "connectedAt"],
          "properties": {
            "id": {
              "type": "string"
            },
            "hostId": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "cols": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "connectedAt": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        }
      },
      "errorSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "knownErrors": [
        "plugin.api.invalidParams",
        "plugin.api.responseTooLarge",
        "plugin.timeout",
        "pluginSecurity.blocked",
        "pluginSecurity.changed",
        "pluginSecurity.approvalRequired",
        "pluginSecurity.permissionDenied",
        "pluginSecurity.unavailable"
      ],
      "events": []
