      "ownership": "runtime",
      "permissions": ["fileBrowser.read", "workspace.write"],
      "limits": {
        "perPlugin": 8,
        "total": 128,
        "rulesPerCollection": 256
      }
    },
    {
      "id": "statusBar.items",
      "domain": "workbench",
      "layer": "presentation",
      "stability": "stable",
      "composition": "merge",
      "registration": {
        "set": "statusBar.set",
        "remove": "statusBar.remove"
      },
      "ownership": "runtime",
      "permissions": [],
      "limits": {
        "perPlugin": 8,
        "total": 128
