{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tunnelde.dev/contracts/api-describe-v1.schema.json",
  "title": "Plugin API discovery v1 response",
  "description": "Compatibility floor for api.describe. Consumers must ignore unknown fields and stability values.",
  "type": "object",
  "required": ["version", "methods"],
  "properties": {
    "version": { "const": 1 },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "permissions", "params", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "params": { "type": "string" },
          "description": { "type": "string" },
          "stability": { "type": "string" },
          "since": { "type": ["string", "null"] },
          "deprecated": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
