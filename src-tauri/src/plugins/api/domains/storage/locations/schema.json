{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental host storage location metadata v1",
  "description": "Structural schema; additionally enforce UTF-8 bytes, exact category order, distinct plan categories, paired revisions, encoded snapshot <=127KiB and response <=128KiB.",
  "definitions": {
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000-\\u001f\\u007f-\\u009f]*$(?![\\s\\S])"
    },
    "category": {
      "enum": ["database", "plugins", "pluginData", "keys", "runtimes", "cache", "logs", "runners"]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "target", "migrate"],
      "properties": {
        "category": {
          "$ref": "#/definitions/category"
        },
        "target": {
          "$ref": "#/definitions/path"
        },
        "migrate": {
          "type": "boolean"
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/change"
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "path", "defaultPath", "overridden"],
      "properties": {
        "category": {
          "$ref": "#/definitions/category"
        },
        "path": {
          "$ref": "#/definitions/path"
        },
        "defaultPath": {
          "$ref": "#/definitions/path"
        },
        "overridden": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "locations", "pending", "recoveryRequired"],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "locations": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/location"
          }
        },
        "pending": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["changes"],
              "properties": {
                "changes": {
                  "$ref": "#/definitions/changes"
                }
              }
            }
          ]
        },
        "recoveryRequired": {
          "type": "boolean"
        }
      }
    },
    "observeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "revision": {
          "$ref": "#/definitions/revision"
        }
      }
    },
    "scheduleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "changes"],
      "properties": {
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "changes": {
          "$ref": "#/definitions/changes"
        }
      }
    },
    "cancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": {
          "$ref": "#/definitions/revision"
        }
      }
    },
    "changeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "outcome", "snapshot"],
      "properties": {
        "version": {
          "const": 1
        },
        "outcome": {
          "enum": ["scheduled", "cancelled", "dismissed"]
        },
        "snapshot": {
          "$ref": "#/definitions/snapshot"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "changed"],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "changed": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "changed", "snapshot"],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "changed": {
          "const": true
        },
        "snapshot": {
          "$ref": "#/definitions/snapshot"
        }
      }
    }
  ]
}
