{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental persisted log reading v1",
  "description": "Shared persisted log projection. Adapters enforce their own authorization; entries may contain sensitive application and plugin data. UTF-8 byte, encoded response, Unicode, safe number, field depth and record limits also apply.",
  "definitions": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/json"
          }
        }
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          }
        },
        "plugins": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          }
        },
        "levels": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["trace", "debug", "info", "warn", "error"]
          }
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256,
          "x-maxBytes": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$(?![\\s\\S])"
        }
      },
      "required": []
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": ["diagnostics", "operations"]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "filter": {
          "$ref": "#/definitions/filter"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": []
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamp": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ]
        },
        "level": {
          "enum": ["trace", "debug", "info", "warn", "error"]
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        },
        "pluginId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/json"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": ["timestamp", "level", "domain", "pluginId", "message", "fields", "truncated"]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "source": {
          "enum": ["diagnostics", "operations"]
        },
        "entries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/entry"
          }
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
        },
        "hasMore": {
          "type": "boolean"
        },
        "reset": {
          "type": "boolean"
        },
        "gap": {
          "type": "boolean"
        }
      },
      "required": ["version", "source", "entries", "cursor", "hasMore", "reset", "gap"]
    }
  },
  "$ref": "#/definitions/page"
}
