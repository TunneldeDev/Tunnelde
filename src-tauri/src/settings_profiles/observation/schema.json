{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental profile metadata observation v1",
  "definitions": {
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "$ref": "#/definitions/revision"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])"
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "items"],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/metadata"
          }
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "revision", "changed"],
          "properties": {
            "version": {
              "const": 1
            },
            "revision": {
              "$ref": "#/definitions/revision"
            },
            "changed": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "revision", "changed", "snapshot"],
          "properties": {
            "version": {
              "const": 1
            },
            "revision": {
              "$ref": "#/definitions/revision"
            },
            "changed": {
              "const": true
            },
            "snapshot": {
              "$ref": "#/definitions/snapshot"
            }
          }
        }
      ]
    }
  },
  "$ref": "#/definitions/observation",
  "description": "Structural v1 schema. Host and SDK additionally enforce UTF-8 byte bounds, unique IDs and case-insensitive names, trimmed names, matching revisions and the 32 KiB encoded response bound."
}
