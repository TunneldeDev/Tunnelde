{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "editor",
  "type": "object",
  "properties": {
    "wordWrap": {
      "type": "boolean"
    },
    "tabSize": {
      "type": "integer",
      "enum": [
        2,
        4,
        8
      ]
    },
    "spellCheck": {
      "type": "boolean"
    }
  },
  "required": [
    "wordWrap",
    "tabSize",
    "spellCheck"
  ],
  "additionalProperties": false
}
