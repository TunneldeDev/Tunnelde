    "statusBar.set": {
      "version": 1,
      "errorSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "knownErrors": [
        "plugin.statusBar.invalidItem",
        "plugin.statusBar.unknownCommand",
        "plugin.statusBar.limit",
        "plugin.api.invalidParams",
        "plugin.api.responseTooLarge",
        "plugin.api.missing:id",
        "plugin.api.invalid:id",
        "plugin.timeout",
        "pluginSecurity.blocked",
        "pluginSecurity.changed",
        "pluginSecurity.approvalRequired",
        "pluginSecurity.permissionDenied",
        "pluginSecurity.unavailable"
      ],
      "events": [],
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$(?![\\s\\S])"
          },
          "text": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$(?![\\s\\S])",
            "minLength": 1
          },
          "alignment": {
            "enum": ["left", "right"],
            "default": "left"
          },
          "priority": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000,
            "default": 0
          },
          "tooltip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]*$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "icon": {
            "enum": [
              "activity",
              "check",
              "alert",
              "info",
              "sync",
              "terminal",
              "cloud",
              "code",
              "plug",
              null
            ]
          },
          "command": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      },
      "resultSchema": {
        "type": "null"
      }
    },
