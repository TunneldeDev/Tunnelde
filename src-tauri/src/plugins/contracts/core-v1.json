{
  "version": 1,
  "methods": {
    "api.describe": {
      "version": 1,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true
      },
      "resultSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Plugin API discovery v1 response",
        "description": "Compatibility floor for api.describe. Consumers must ignore unknown fields and stability values.",
        "type": "object",
        "required": ["version", "methods"],
        "properties": {
          "version": {
            "const": 1
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "permissions", "params", "description"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "params": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "stability": {
                  "type": "string"
                },
                "since": {
                  "type": ["string", "null"]
                },
                "deprecated": {
                  "type": ["string", "null"]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "errorSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "knownErrors": [
        "plugin.api.invalidParams",
        "plugin.api.responseTooLarge",
        "plugin.timeout",
        "pluginSecurity.blocked",
        "pluginSecurity.changed",
        "pluginSecurity.approvalRequired",
        "pluginSecurity.permissionDenied",
        "pluginSecurity.unavailable"
      ],
      "events": []
    },
    "sessions.list": {
      "version": 1,
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
